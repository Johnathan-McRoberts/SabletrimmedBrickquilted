{
  "name": "sabletrimmed-brickquilted",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:sabletrimmed-brickquilted": "node dist/sabletrimmed-brickquilted/server/server.mjs",
    "test:local": "ng test --browsers Chrome",
    "test:ci": "ng test --code-coverage --browsers ChromeHeadlessNoSandbox --watch=false --source-map=false --karma-config=./karma.conf.ci.js",
    "lint:check": "ng lint",
    "lint:fix": "ng lint --fix",
    "prettier:config": "prettier \"src/**/*{.ts,.html,.scss,.json}\"",
    "prettier:check": "npm run prettier:config -- --check",
    "prettier:fix": "npm run prettier:config -- --write",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/cdk": "^21.2.13",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.13",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.13",
    "@ng-bootstrap/ng-bootstrap": "^20.0.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "chartjs-adapter-luxon": "^1.3.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "express": "^5.1.0",
    "luxon": "^3.7.2",
    "ng2-charts": "^10.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.13",
    "@angular/cli": "^21.2.13",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/localize": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/chart.js": "^2.9.41",
    "@types/express": "^5.0.1",
    "@types/luxon": "^3.7.2",
    "@types/node": "^20.17.19",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  }
}
